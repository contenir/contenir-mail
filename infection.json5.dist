{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "timeout": 30,
    "threads": "max",
    "logs": {
        "text": "infection.log",
        "summary": "summary.log",
        "stryker": {
            "badge": "/^(main|master|\\d+\\.\\d+\\.x)$/"
        }
    },
    "mutators": {
        "@default": true,
        "CastString": {
            "ignore": [
                // Address has validated the domain through the same UTS #46 conversion, so
                // idn_to_ascii() cannot return false here and the cast never applies.
                "Contenir\\Mail\\Header\\AddressEncoder::asciiEmail",
                // fread() on an open, readable stream returns a string, so the cast never applies.
                "Contenir\\Mail\\Mime\\Part::encodeStreamAsBase64"
            ]
        },
        "CastArray": {
            // preg_split() fails only for an invalid pattern or UTF-8 subject; the pattern is fixed
            // and has no "u" flag, so it never fails and the cast never applies.
            "ignore": ["Contenir\\Mail\\Dkim\\Signer::fields"]
        },
        "DecrementInteger": {
            "ignore": [
                // Any read size gives the same output, as unencoded bytes carry over to the next read.
                "Contenir\\Mail\\Mime\\Part::encodeStreamAsBase64",
                // The default of 0 lines is clamped to 0 before use, so -1 asks for the same TOP.
                "Contenir\\Mail\\Protocol\\Pop3::top",
                // A nanosecond more or less on the deadline, or a microsecond on the 10 ms poll,
                // cannot be observed; the timeout tests check the program is stopped promptly.
                "Contenir\\Mail\\Transport\\SendmailProcess::wait",
                // Resuming a search one byte earlier only searches a byte that cannot start the
                // needle again: a needle starting there would have been found in the bytes before.
                "Contenir\\Mail\\Storage\\Part\\Window::resume"
            ],
            "ignoreSourceCodeByRegex": [
                // HeaderValue::isValid() has just checked the character after the CRLF is a
                // space or tab, so stepping onto it again only re-validates a valid character.
                "\\$i \\+= 2;",
                // Not stripping the "(" of a nested list leaves the tokenizer pushing lists forever;
                // the mutant can only end by exhausting memory, never by a failing assertion.
                "\\$token\\s+= substr\\(\\$token, offset: 1\\);",
                // The TNEF checksum sums each byte value times its count. Mode 0 also lists the
                // byte values that do not occur, with a count of 0, which add nothing to the sum.
                "foreach \\(count_chars\\(\\$data, mode: 1\\) as \\$byte => \\$count\\) {"
            ]
        },
        "IncrementInteger": {
            "ignoreSourceCodeByRegex": [
                // The XOAUTH2 challenge follows "+ "; strict base64 decoding skips the space, so
                // starting one character later reads the same JSON.
                "substr\\(\\$line, offset: 1\\),"
            ],
            "ignore": [
                // Skipping a fourth continuation byte also ends at a unit start: a byte after three
                // continuation bytes is a unit of its own, so the slices come out equivalent.
                "Contenir\\Mail\\Utf8::sliceEnd",
                // Any read size gives the same output, as unencoded bytes carry over to the next read.
                "Contenir\\Mail\\Mime\\Part::encodeStreamAsBase64",
                // A nanosecond more or less on the deadline, or a microsecond on the 10 ms poll,
                // cannot be observed; the timeout tests check the program is stopped promptly.
                "Contenir\\Mail\\Transport\\SendmailProcess::wait",
                // Forgetting one byte fewer only keeps it in memory; no read reaches back to it.
                "Contenir\\Mail\\Storage\\Part\\Window::forget"
            ]
        },
        "MethodCallRemoval": {
            // Not forgetting the bytes a search has passed only keeps them in memory; the
            // same needle is found at the same offset.
            "ignore": ["Contenir\\Mail\\Storage\\Part\\Window::find"]
        },
        "GreaterThan": {
            // As for IncrementInteger above: forgetting nothing when there is nothing to forget
            // takes an empty substring off the buffer, which leaves it as it is.
            "ignore": ["Contenir\\Mail\\Storage\\Part\\Window::forget"]
        },
        "Plus": {
            // As for DecrementInteger above: resuming two bytes earlier searches only bytes in
            // which the needle was already looked for, and found not to start.
            "ignore": ["Contenir\\Mail\\Storage\\Part\\Window::resume"]
        },
        "FunctionCallRemoval": {
            "ignore": [
                // Without the 10 ms sleep the loop only polls faster; without proc_close() the
                // process handle is released when it goes out of scope instead. Neither is observable.
                "Contenir\\Mail\\Transport\\SendmailProcess::wait",
                // Writes are made non-blocking so the stream timeout bounds them where a blocking
                // write would wait forever (macOS). On Linux, PHP already bounds blocking socket writes
                // by the timeout (MSG_DONTWAIT and poll), so leaving the stream blocking behaves the same.
                "Contenir\\Mail\\Protocol\\StreamConnection::write"
            ]
        },
        "FalseValue": {
            // As for FunctionCallRemoval above: a blocking write is bounded by the timeout on Linux too.
            "ignore": ["Contenir\\Mail\\Protocol\\StreamConnection::write"]
        },
        "LessThan": {
            // Stopping at the deadline or one poll later cannot be told apart.
            "ignore": ["Contenir\\Mail\\Transport\\SendmailProcess::wait"]
        },
        "Modulus": {
            // Encoding fewer whole groups per read only keeps more bytes buffered; the output is
            // the same, as whatever is left over is encoded at the end.
            "ignore": ["Contenir\\Mail\\Mime\\Part::encodeStreamAsBase64"]
        },
        "TrueValue": {
            // $tryApop is unused: XOAUTH2 has no APOP. It keeps the Protocol\Pop3::login() signature.
            "ignore": ["Contenir\\Mail\\Protocol\\Pop3\\Xoauth2\\Microsoft::login"]
        },
        "ReturnRemoval": {
            // The chunked stream encoder only saves memory: falling through to Mime::encode()
            // gives the same output, which PartTest asserts for many lengths and read sizes.
            "ignore": [
                "Contenir\\Mail\\Mime\\Part::getEncodedContent",
                // Returning valid UTF-8 at once only saves time: scrubbing it changes nothing.
                "Contenir\\Mail\\Utf8::scrub",
                // Returning the cached position only saves searching the line again: a fresh
                // search from the same offset finds the same position. TokenizerScalingTest
                // guards the time it saves.
                "Contenir\\Mail\\Protocol\\Imap::nextFrom"
            ]
        },
        "UnwrapSubstr": {
            // As for DecrementInteger above: a nested list that keeps its "(" is pushed forever.
            "ignoreSourceCodeByRegex": ["\\$token\\s+= substr\\(\\$token, offset: 1\\);"]
        },
        "LogicalAndAllSubExprNegation": {
            // Negating both bounds walks the cut point below zero until memory runs out;
            // the mutant can only end in a crash, which Utf8Test cannot assert.
            "ignore": ["Contenir\\Mail\\Utf8::cut"]
        },
        "ProtectedVisibility": {
            // Protocol\Smtp overrides _disconnect() with #[Override], so a private parent
            // method is a compile-time fatal error rather than a behaviour a test can observe.
            "ignore": ["Contenir\\Mail\\Protocol\\AbstractProtocol::_disconnect"]
        },
        "GreaterThanOrEqualTo": {
            // A position equal to the offset is where a fresh search from that offset would
            // find the needle again, so searching anew gives the same position.
            "ignore": ["Contenir\\Mail\\Protocol\\Imap::nextFrom"]
        },
        "Coalesce": {
            // Scrubbing by character gives the same result as scrubbing by run, only slower,
            // which is why it is the fallback; Utf8ScrubTest checks both paths.
            "ignore": ["Contenir\\Mail\\Utf8::scrub"]
        }
    },
    "staticAnalysisTool": "mago"
}
