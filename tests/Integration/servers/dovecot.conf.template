# IMAP and POP3 for the integration suite, shared by every Dovecot instance:
# one user whose mbox folders are the test fixtures, copied in by the tests
# themselves. Each instance adds its own passdb, and may override settings,
# in /etc/dovecot/instance.conf.
protocols = imap pop3 lmtp
listen = *
log_path = /dev/stderr

ssl = yes
ssl_cert = </certs/server.crt
ssl_key = </certs/server.key
ssl_dh = </certs/dh.pem

disable_plaintext_auth = no
# The instance's passdb decides how XOAUTH2 and OAUTHBEARER tokens are checked.
auth_mechanisms = plain login xoauth2 oauthbearer
# LMTP recipients such as inbox@example.org are the user "inbox".
auth_username_format = %Ln
postmaster_address = postmaster@example.org

first_valid_uid = 1
first_valid_gid = 1
mail_location = mbox:/srv/mail/%u:INBOX=/srv/mail/%u/INBOX
mbox_write_locks = fcntl

userdb {
  driver = static
  args = uid=${MAIL_UID} gid=${MAIL_GID} home=/srv/mail/%u
}

service auth {
  inet_listener {
    port = 12345
  }
}

service lmtp {
  inet_listener lmtp {
    port = 24
  }
}

protocol pop3 {
  pop3_uidl_format = %08Xu%08Xv
}

!include /etc/dovecot/instance.conf
