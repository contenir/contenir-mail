# IMAP and POP3 for the integration suite: one static user whose mbox
# folders are the test fixtures, copied in by the tests themselves.
protocols = imap pop3 lmtp
listen = *
log_path = /dev/stderr

ssl = yes
ssl_cert = </certs/server.crt
ssl_key = </certs/server.key
ssl_dh = </certs/dh.pem

disable_plaintext_auth = no
# XOAUTH2 and OAUTHBEARER check the token as the passdb password, so the
# token is the same secret as the password. SCRAM-SHA-256 derives its keys
# from that plaintext password.
auth_mechanisms = plain login xoauth2 oauthbearer scram-sha-256
# LMTP recipients such as inbox@example.org are the user "inbox".
auth_username_format = %Ln
postmaster_address = postmaster@example.org

first_valid_uid = 1
first_valid_gid = 1
mail_location = mbox:/srv/mail/%u:INBOX=/srv/mail/%u/INBOX
mbox_write_locks = fcntl

# The default namespace, written out so a folder can be given a special use
# (RFC 6154). Trash is not created: ImapFolderMetadataTest creates it.
namespace inbox {
  inbox = yes
  separator = /
  mailbox Trash {
    special_use = \Trash
  }
}

# Every test connects from the same address, and Postfix asks over one auth
# connection, so the wrong-password tests would build up an auth penalty of up
# to 15 seconds, and a 2-second delay on each failure, and outlast the Postfix
# SASL timeout. Neither protects anything here.
auth_failure_delay = 0
passdb {
  driver = static
  args = password=${MAIL_PASSWORD} nopenalty
}

userdb {
  driver = static
  args = uid=${MAIL_UID} gid=${MAIL_GID} home=/srv/mail/%u
}

service auth {
  inet_listener {
    port = 12345
  }
}

service lmtp {
  inet_listener lmtp {
    port = 24
  }
}

protocol pop3 {
  pop3_uidl_format = %08Xu%08Xv
}
